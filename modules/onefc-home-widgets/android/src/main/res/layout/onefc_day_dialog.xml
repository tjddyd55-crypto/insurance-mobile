<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:background="@color/onefc_widget_bg"
  android:padding="16dp"
  android:minWidth="280dp">

  <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/day_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="@dimen/onefc_widget_month_text" android:textStyle="bold" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/day_close" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="4dp" android:text="@string/onefc_widget_day_close" android:textSize="@dimen/onefc_widget_item_text" android:textColor="@color/onefc_widget_text_secondary" />
  </LinearLayout>

  <ScrollView android:id="@+id/day_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/day_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center" android:textSize="@dimen/onefc_widget_item_text" android:textColor="@color/onefc_widget_text_secondary" android:maxLines="3" android:ellipsize="end" />
      <LinearLayout android:id="@+id/day_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
  </ScrollView>

  <TextView android:id="@+id/day_add" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:gravity="center" android:background="@drawable/onefc_widget_pill" android:text="@string/onefc_widget_day_add" android:textSize="@dimen/onefc_widget_item_text" android:textStyle="bold" android:textColor="@color/onefc_widget_brand" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
