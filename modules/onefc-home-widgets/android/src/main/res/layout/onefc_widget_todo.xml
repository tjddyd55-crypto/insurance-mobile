<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/onefc_widget_bg" android:padding="10dp">

  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/onefc_widget_brand_mark" />
    <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="ONE FC 할 일" android:textColor="@color/onefc_widget_text" android:textSize="@dimen/onefc_widget_title_text" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <ImageView android:id="@+id/w_refresh" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:src="@drawable/onefc_widget_ic_refresh" android:contentDescription="@string/onefc_widget_refresh" />
    <ImageView android:id="@+id/w_add" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:src="@drawable/onefc_widget_ic_add" android:contentDescription="@string/onefc_widget_add_todo" />
  </LinearLayout>

  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_prev" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="@dimen/onefc_widget_nav_text" android:textColor="@color/onefc_widget_text_secondary" android:contentDescription="@string/onefc_widget_prev_day" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_day_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="@dimen/onefc_widget_header_text" android:textStyle="bold" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="@dimen/onefc_widget_nav_text" android:textColor="@color/onefc_widget_text_secondary" android:contentDescription="@string/onefc_widget_next_day" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_0" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_0" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_1" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_1" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_2" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_2" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_3" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_3" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_4" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_4" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_5" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_5" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_6" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_6" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/w_todo_7" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_todo_check_7" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="@dimen/onefc_widget_todo_text" android:textColor="@color/onefc_widget_brand" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_todo_title_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textSize="@dimen/onefc_widget_todo_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <TextView android:id="@+id/w_more" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:textSize="@dimen/onefc_widget_meta_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_brand" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  <LinearLayout android:id="@+id/w_empty_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/w_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/onefc_widget_empty_todo" android:textSize="@dimen/onefc_widget_item_text" android:textColor="@color/onefc_widget_text_secondary" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_empty_add" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginTop="4dp" android:background="@drawable/onefc_widget_pill" android:text="@string/onefc_widget_empty_todo_add" android:textSize="@dimen/onefc_widget_item_text" android:textColor="@color/onefc_widget_brand" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="@dimen/onefc_widget_status_text" android:textColor="@color/onefc_widget_text_meta" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_to_today" android:layout_width="wrap_content" android:layout_height="22dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:background="@drawable/onefc_widget_pill" android:text="@string/onefc_widget_to_today" android:textSize="@dimen/onefc_widget_meta_text" android:fontFamily="sans-serif-medium" android:textColor="@color/onefc_widget_brand" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
