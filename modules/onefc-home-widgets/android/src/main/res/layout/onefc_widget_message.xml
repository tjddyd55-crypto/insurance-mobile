<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/onefc_widget_bg" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/onefc_widget_brand_mark" />
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/onefc_widget_text" android:textSize="14sp" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/w_msg_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/onefc_widget_text" android:textSize="14sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/w_msg_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/onefc_widget_text_secondary" android:textSize="12sp" android:gravity="center" />
  </LinearLayout>
</LinearLayout>
