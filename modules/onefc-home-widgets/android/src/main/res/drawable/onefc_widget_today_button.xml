<?xml version="1.0" encoding="utf-8"?>
<!-- 일정 위젯 머리글 '오늘' 버튼: 작은 달력 테두리(터치 영역은 버튼 전체, 그림은 안쪽). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="6dp" android:insetBottom="6dp">
  <shape android:shape="rectangle">
    <solid android:color="@color/onefc_widget_brand_soft" />
    <stroke android:width="1.5dp" android:color="@color/onefc_widget_brand" />
    <corners android:radius="6dp" />
  </shape>
</inset>
