# Local Expo public env (non-secret). Copy to .env for overrides.
# Secrets must never be placed here.

EXPO_PUBLIC_APP_ENV=development
# Optional local phone coexistence variant: APP_VARIANT=device

# Public API origins only (no DB / JWT / payment secrets)
EXPO_PUBLIC_API_BASE_URL_DEV=https://insurance-dev.up.railway.app
EXPO_PUBLIC_API_BASE_URL_PROD=https://insurance-production-7bd8.up.railway.app

# Public mobile map SDK key. Required for Android native Google Maps rendering.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
